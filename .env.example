# --- core ---
EA_KEY=change-me-long-random   # the OWNER's EA key. Subscribers get personal keys inside the app (no env var needed)
ADMIN_EMAILS=you@gmail.com
ADMIN_PASS=change-me-8-or-more-characters   # admin access pass: open #admin on the site and type it. Leave empty to turn the pass off
BASE_URL=https://your-service.onrender.com
SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY
MIN_CONFLUENCE=2
RISK_PCT=1.0
MAX_OPEN=3
MAX_OPEN_CEILING=6
MAX_TRADES_DAY=0
RR=2.0
COOLDOWN_MIN=60
# --- safety gates (all editable later by the admin in the app) ---
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=6.0
MAX_LOSING_STREAK=3          # this many losses in a row pauses new trades...
STREAK_COOLDOWN_H=4          # ...for this many hours
MAX_CCY_EXPOSURE=2           # max same-direction trades on one currency (EURUSD+GBPUSD+AUDUSD buys all short USD)
NEWS_LOCK=1                  # pause 30 min before/after high-impact news (ForexFactory feed, no key needed)
NEWS_BEFORE_MIN=30
NEWS_AFTER_MIN=30
# --- Supabase (database + sign-in). Project Settings > API, and Database > Connection string ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=           # "anon public" key (safe for the browser)
SUPABASE_SERVICE_KEY=        # "service_role" key. SECRET. Server only. Used to delete accounts.
# Use the *Session pooler* string (host ...pooler.supabase.com, port 5432). Render's free tier cannot reach the direct IPv6 host.
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# --- Sign-in emails: Resend, set up INSIDE Supabase (nothing to put in Render for it). Full steps: README "Sign-in emails" ---
#   Auth > SMTP Settings: enable custom SMTP. host smtp.resend.com, port 465, username resend, password = your Resend API key (re_...)
#   Sender email = an address on a domain you verified in Resend (e.g. noreply@yourdomain.com). Sender name = spaceXBot.
#   Auth > Providers > Email: "Confirm email" ON, email OTP length 6.
#   Auth > Email Templates: "Confirm signup" and "Reset Password" must contain {{ .Token }} (the 6-digit code). A template with only
#   {{ .ConfirmationURL }} sends a link, and the code screen in the app will never get a code.
#   Auth > URL Configuration: Site URL = your BASE_URL above; add it under Redirect URLs (needed for Google sign-in).
# --- Email alerts and receipts: Resend API. These DO go in Render (sign-in codes use Supabase SMTP instead, see above) ---
RESEND_API_KEY=              # re_... key. Can be the same key Supabase SMTP uses
MAIL_FROM=spaceXBot <alerts@yourdomain.com>   # an address on a domain verified in Resend
MAIL_ALERT_CAP=60            # trade alert emails per day, all people together. Resend free plan is about 100/day and sign-in codes share it
MAIL_HARD_CAP=90             # receipts may go on to this many per day
# --- FinoQ (formerly PayHero) M-Pesa. Same values as Comrade Connect ---
PAYHERO_API_KEY=             # FinoQ dashboard > API Keys > API Username
PAYHERO_API_SECRET=
PAYHERO_CHANNEL_ID=
PAYHERO_ACCOUNT_ID=          # only needed for payouts (not used here yet)
PAYHERO_PROVIDER=sasapay      # sasapay is the default and the real prompt. Leave it like this
PAYHERO_BASE_URL=https://api.finoq.africa
# REQUIRED. FinoQ posts results to {BASE_URL}/api/webhooks/payhero?s=<this secret> (the app builds that URL itself)
PAYHERO_CALLBACK_SECRET=another-long-random
# Supabase > Auth > Hooks > Send Email (HTTPS) secret, looks like v1,whsec_xxxx. With it, sign-up and reset codes are emailed by this app through Resend
SEND_EMAIL_HOOK_SECRET=
# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=live              # sandbox while testing
# --- Phone alerts (Firebase Cloud Messaging). Full steps: README "Phone alerts" ---
FCM_SERVICE_ACCOUNT=         # Firebase > Project settings > Service accounts > Generate new private key. Paste the whole JSON on ONE line (or its base64). SECRET. Empty = no phone alert is sent
PUBLIC_URL=https://your-service.onrender.com   # public address of this server; the alert pictures load from {PUBLIC_URL}/notif/<name>.png
PUSH_DAILY_CAP=30            # most alerts one person gets per day (risk and billing alerts ignore the cap). N2 raises the default to 30
# GOOGLE_SERVICES_JSON_BASE64 is NOT a Render variable. It is a GitHub secret (repo > Settings > Secrets and variables > Actions) used by the Android build:
#   base64 -w0 google-services.json    -> paste the output as the secret. Without it the APK is built without phone alerts.
# --- Deriv bot (S1). Without these two the Deriv bot never trades, and the admin health card says so ---
BROKER_KEY=                  # 16+ random characters. Locks every saved Deriv/Binance token. Never change it later or saved tokens become unreadable
DERIV_APP_ID=                # YOUR Deriv app id (same for everyone). Without it the Deriv loop skips everybody
DERIV_EVERY=60               # seconds between rounds (minimum 30)
DERIV_REAL=0                 # 1 = also allow REAL Deriv accounts (a customer must ALSO pick Real mode). Leave 0 until demo results are proven
# --- testing only: never set on Render ---
DEV_AUTH=0
